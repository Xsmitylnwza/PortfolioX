{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*", "*.config.js", "*.config.mjs", "*.config.ts", "*.config.mts"],
  "exclude": ["node_modules", "dist", "output", "scripts/fixtures"]
}
